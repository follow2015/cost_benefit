# ============================================================
# AI 算力投资经济性测算平台 · 环境变量样例（redesign 基线）
# 复制为 .env 后按需修改；所有字段均有默认值，无 .env 亦可启动
# （数据库连接除外——容器编排由 docker-compose.v2.yml 注入）。
# ============================================================

# ---- 应用 ----
APP_NAME=ai-roi-calculator
APP_ENV=dev                       # dev | staging | prod
API_V1_PREFIX=/api/v1

# ---- 数据库（PostgreSQL 16，业务表位于 app schema，RLS 多租户）----
# 方式一：直接给完整连接串（推荐）
DATABASE_URL=postgresql+asyncpg://airoi:<your-db-password>@localhost:5433/airoi
# 方式二：显式参数（提供 HOST/USER/DATABASE 时自动组合，覆盖上方）
# POSTGRESQL_HOST=localhost
# POSTGRESQL_PORT=5433
# POSTGRESQL_USER=airoi
# POSTGRESQL_PASSWORD=change-me
# POSTGRESQL_DATABASE=airoi
DB_ECHO=false
DB_SCHEMA=app

# ---- 鉴权（JWT 双令牌；生产必须更换为强随机密钥）----
JWT_SECRET=change-me-in-production-please-32chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_MINUTES=20160

# ---- 汇率（全项目唯一口径）----
# 基准库权威同步与 InferenceX 成本标杆折算共用此值，不要再各写一份。
# 权威值由「基准库 → 权威同步」双源投票给出（open.er-api.com + exchangerate-api.com）；
# 此处仅为离线兜底，长期应以页面上的权威值为准。
FX_USD_CNY=6.68

# ---- 外部基准采集（InferenceX / SemiAnalysis）----
# 服务启动即接管：每隔 INFERENCEX_SYNC_INTERVAL_DAYS 天自动拉一次成本标杆，
# 未到周期只做判定不发请求；也可在「基准库」页点「立即采集」手动触发。
INFERENCEX_SYNC_ENABLED=true
INFERENCEX_SYNC_INTERVAL_DAYS=14
INFERENCEX_BASE_URL=https://inferencex.semianalysis.com

# ---- CORS（逗号分隔或 JSON 数组）----
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# ---- Redis（可选组件：刷新令牌黑名单 / 限流 / 缓存；留空则退化为进程内实现）----
REDIS_URL=redis://localhost:6379/0
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_MAX_CONNECTIONS=20

# ---- 全局口径（主理人已确认，不可随意变更）----
DEFAULT_CURRENCY=CNY              # 本位币
DEFAULT_TAXED=false               # 税前口径
