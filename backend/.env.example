# ---- 后端环境变量示例：复制为 .env 后按需修改 ----
APP_NAME=ai-roi-calculator
APP_ENV=dev
API_V1_PREFIX=/api/v1

# PostgreSQL 16（docker-compose.yml 默认起的实例）
DATABASE_URL=postgresql+asyncpg://roi:roi_pwd@localhost:5432/ai_roi
# 同步 URL（Alembic 迁移使用，由 config.py 自动派生，可显式覆盖）
# DATABASE_URL_SYNC=postgresql+psycopg2://roi:roi_pwd@localhost:5432/ai_roi

# JWT
# ⚠️ 生产必须换成随机 32+ 字符（`python -c "import secrets;print(secrets.token_urlsafe(48))"`）。
#    APP_ENV=prod 时若仍是下面这个示例值，进程会直接拒绝启动 —— 留着它等于
#    任何人都能自己签一个 token 冒充任意租户。
JWT_SECRET=change-me-in-production-please-32chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_MINUTES=20160

# ---- 对外暴露面 ----
# 允许的 Host 头。默认 * 不校验（保持既有部署不变）。
# 生产应写成实际域名，并保留 127.0.0.1（反代健康检查会带这个 Host）：
#   TRUSTED_HOSTS=roi.example.com,127.0.0.1
TRUSTED_HOSTS=*

# 是否暴露 /docs、/redoc、/openapi.json。
# 留空按 APP_ENV 推断：dev 开，其余关。文档页会把全部路径、参数与鉴权方式摊开。
#   ENABLE_API_DOCS=false

# ---- 演示账号（仅 `python -m scripts.seed` 使用）----
SEED_DEMO_EMAIL=demo@airoi.dev
# 留空 = 每次随机生成 20 位并在终端打印一次。
# 不要在这里写弱口令：该账号是 owner 权限，且这个文件随仓库分发。
SEED_DEMO_PASSWORD=

# 登录防爆破（失败限流：仅计密码错误，成功不计入）
LOGIN_RATE_MAX_FAILURES=5
LOGIN_RATE_WINDOW_SECONDS=300

# CORS（前端 dev server）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 全局口径默认值（已由主理人确认：CNY / 税前）
DEFAULT_CURRENCY=CNY
DEFAULT_TAXED=false

# 外部基准采集（InferenceX·SemiAnalysis）
# 周期：上游每周发快照，这里按周跟进；改大只会让数据变旧，不会省请求
INFERENCEX_SYNC_INTERVAL_DAYS=7
# 采集开关（关掉后只有手动「立即采集」与 CLI 能触发）
INFERENCEX_SYNC_ENABLED=true
# USD→CNY 汇率：全站唯一口径。基准价、成本标杆、前端展示都读它，
# 不要在别处再写死 7.2 —— 历史上前端硬编码 7.2 与库内 6.76 并存，同一模型两套价
FX_USD_CNY=6.68

# 可选 Redis（不配置则各适配器自动退化为进程内实现）：
# 刷新令牌轮换黑名单 / 登录失败限流 / 无状态试算结果缓存
REDIS_URL=
