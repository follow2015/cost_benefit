    "verify:golden": "node scripts/verify-consistency.mjs",
    "e2e": "npx playwright test",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@tanstack/react-query": "^5.62.7",
    "antd": "^6.6.8",
    "axios": "^1.7.9",
    "decimal.js": "^10.4.3",
    "echarts": "^5.5.1",
    "echarts-for-react": "^3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
