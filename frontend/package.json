{
  "name": "ai-roi-calculator-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI 算力投资 ROI 测算平台前端（P0 MVP）。React 19 + TS + Vite + AntD + Zustand + TanStack Query + RR + Axios + ECharts。",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
