# 前端环境变量示例（复制为 .env.local 并据实修改）。
#
# ⚠️ 这里的值会**编译进前端产物**，浏览器与任何拿到 dist 的人都能读到。
#    不要放密钥、不要放演示密码。

# 后端 API 基地址（不含 /api 前缀）。生产可填网关地址。
# 经 nginx 同源反代时留空，让前端拼相对路径 /api/v1/...（见 client.ts）。
VITE_API_BASE=http://localhost:8000

# 开发服务器代理目标（vite.config.ts 中 /api 的转发目标）
VITE_API_PROXY=http://localhost:8000

# 开发服务器端口
FRONTEND_PORT=5173

# 开发服务器监听地址。**只填回环**（127.0.0.1），不要填 :: 或 0.0.0.0 ——
# dev server 会原样吐出 /src/**.tsx，绑到外网网卡等于公开源码。
# 留空时 Vite 用 'localhost'，Windows 上会只解析成 [::1]，nginx 反代 127.0.0.1 会 502。
FRONTEND_HOST=127.0.0.1

# dev server 的 Host 头白名单（防 DNS rebinding）。默认只放行本机；
# 需要经局域网 IP / 域名访问时追加，例如 192.168.1.20,roi.example.com
# 不要写 *（等于关掉这项防护）。
VITE_ALLOWED_HOSTS=127.0.0.1,localhost

# 是否在登录页提示演示账号（只提示「去哪看」，不含密码）。默认关闭。
# 本地演示想看到提示时才设 true；生产构建请保持关闭。
VITE_DEMO_HINT=false

# 单端计算最大偏差告警阈值（相对，默认 0.001 = 0.1%）
VITE_MAX_DEVIATION=0.001
